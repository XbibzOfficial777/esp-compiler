{
  "arduino_cli": {
    "path": "/root/.local/bin/arduino-cli",
    "auto_install": true
  },
  "platforms": {
    "esp8266": {
      "package": "esp8266:esp8266",
      "manager_url": "https://arduino.esp8266.com/stable/package_esp8266com_index.json",
      "default_fqbn": "esp8266:esp8266:generic"
    },
    "esp32": {
      "package": "esp32:esp32",
      "manager_url": "https://espressif.github.io/arduino-esp32/package_esp32_index.json",
      "default_fqbn": "esp32:esp32:esp32"
    }
  },
  "board": {
    "fqbn": "esp8266:esp8266:generic",
    "auto_detect": true
  },
  "source": {
    "file": "/storage/self/primary/sandbox/compiler/bibz/bibz.ino",
    "dir": ""
  },
  "libraries": {
    "dir": "/root/Arduino/libraries",
    "auto_install": true,
    "extra": []
  },
  "output": {
    "dir": "build"
  },
  "patches": {
    "auto_fix": true,
    "rules": []
  }
}